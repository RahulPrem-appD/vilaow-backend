# Copy to .env for local work. Never commit the real file.

# Render supplies postgres://; the app normalises it to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://localhost/vilaow

# Signs session cookies. Refuses to start in production if left at the default.
SECRET_KEY=dev-only-not-for-production

ENVIRONMENT=development

# Comma separated. The site's origin, so the admin can hold a session cookie.
CORS_ORIGINS=http://localhost:3000

# Where a signing link points (the site, not the API). Emailed to real people,
# so a localhost value paired with a hosted DATABASE_URL is refused at startup.
PUBLIC_SITE_URL=http://localhost:3000

# SMTP. Without these the app logs what it would have sent instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Vilaow

# Firebase Storage — profile photos and licence documents. Unset in development
# falls back to local disk; production refuses that fallback, because Render's
# filesystem is ephemeral and the files would vanish on the next deploy.
# A path to a service account JSON key, never the key itself.
FIREBASE_BUCKET=
FIREBASE_CREDENTIALS_FILE=
