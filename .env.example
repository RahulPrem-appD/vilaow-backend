# Copy to .env for local work. Never commit the real file.

# Render supplies postgres://; the app normalises it to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://localhost/vilaow

# Signs session cookies. Refuses to start in production if left at the default.
SECRET_KEY=dev-only-not-for-production

ENVIRONMENT=development

# Comma separated. The site's origin, so the admin can hold a session cookie.
CORS_ORIGINS=http://localhost:3000

# Where a signing link points (the site, not the API). Emailed to real people,
# so a localhost value paired with a hosted DATABASE_URL is refused at startup.
PUBLIC_SITE_URL=http://localhost:3000

# SMTP. Without these the app logs what it would have sent instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Vilaow

# Firebase Storage — profile photos and licence documents. Unset in development
# falls back to local disk; production refuses that fallback, because Render's
# filesystem is ephemeral and the files would vanish on the next deploy.
FIREBASE_BUCKET=

# The service account key, supplied one of two ways. Set ONE.
#
#   FILE — a path to the downloaded JSON. Best locally: the key lives in one
#   place outside the repo and nothing can print it by accident.
#
#   JSON — the key itself. Render takes the raw file contents; a .env file
#   does NOT, because python-dotenv expands the \n escapes inside private_key
#   and the value arrives unparseable. Use base64 for .env — the code accepts
#   raw JSON or base64 and works this out for itself:
#       python3 -c "import base64,json,sys;print(base64.b64encode(json.dumps(\
#         json.load(open(sys.argv[1])),separators=(',',':')).encode()).decode())" \
#         ~/.config/vilaow/firebase-service-account.json
#
# If both are set the file wins.
FIREBASE_CREDENTIALS_FILE=
FIREBASE_CREDENTIALS_JSON=

# Admin session cookie scope. "lax" (the default) needs the site and the API on
# one registrable domain. Set "none" if they are on different ones — a lax
# cookie is stored at login and then never sent, so sign-in appears to succeed
# and everything after it is a 401.
SESSION_SAMESITE=lax

# The website assistant (/assistant on the site). Off until a key is set.
# The key is the client's own, from console.anthropic.com → API keys; set a
# monthly spend limit there too. While the assistant is a private preview,
# every message needs ASSISTANT_ACCESS_CODE; set ASSISTANT_PUBLIC=true to
# drop the code when it launches.
ANTHROPIC_API_KEY=
ASSISTANT_ACCESS_CODE=
ASSISTANT_PUBLIC=false
# "claude" (the default) or "glm" for Z.ai's GLM models, which then need
# GLM_API_KEY instead of ANTHROPIC_API_KEY. ASSISTANT_MODEL overrides the
# provider's default model.
ASSISTANT_PROVIDER=claude
GLM_API_KEY=

# The WhatsApp follow-up of introductions (change request 12). "off" changes
# nothing. "pretend" plans every step and writes down what it would say,
# sending nothing — for trying it before WhatsApp is approved. "twilio" sends
# for real, and then replaces the two introduction emails. How to set Twilio
# up: docs/whatsapp-templates.md.
WHATSAPP_MODE=off
# The professionals' messages: "el" Greek or "en" English.
WHATSAPP_PRO_LANGUAGE=el
FOLLOWUP_FIRST_REMINDER_HOURS=4
FOLLOWUP_REMINDER_EVERY_HOURS=24
FOLLOWUP_MAX_REMINDERS=3
FOLLOWUP_BUYER_CHECK_HOURS=48
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The approved WhatsApp number, as +30…
TWILIO_WHATSAPP_FROM=
# JSON: {"thank_buyer.en": "HX…", "remind_pro.el": "HX…"}
TWILIO_CONTENT_SIDS=
# The public origin Twilio calls back on: https://vilaow-backend.onrender.com
TWILIO_WEBHOOK_BASE=
# Lets a scheduler run the due steps without a login (header X-Jobs-Key).
# 32 characters or more: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JOBS_SECRET=
