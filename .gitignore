.venv/
__pycache__/
*.pyc
.env

# Local-disk uploads. app/storage.py falls back to this in development when
# FIREBASE_BUCKET is unset — profile photos and licence scans. Real identity
# documents must never end up in the repository.
.uploads/

# The ledger scripts/map_specialties.py writes: real records, not source.
specialties-before-mapping.json

# Ledgers the mapping scripts write before they change anything: a
# record of real people's data, kept beside the run, never committed.
*-before-mapping.json
